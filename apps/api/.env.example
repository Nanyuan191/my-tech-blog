# 环境变量样例 —— 复制成 .env 后按需修改
# .env 已被 .gitignore 排除，不会提交到 Git（里面有密码）

NODE_ENV=development
PORT=3000

# 数据库连接串
# 本地开发：连 docker compose 起的 mysql 容器
#   host=localhost（容器端口映射到宿主机 3306）
# 生产：把 host 换成 db（compose 里的服务名），密码换成强密码
DATABASE_URL="mysql://blog:blog_pass_2026@localhost:3306/blog"

# JWT 密钥 —— 生产环境必须换成随机长串！
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-secret-change-me-in-production-please"
JWT_ACCESS_EXPIRES="2h"
JWT_REFRESH_EXPIRES="7d"

# 开发时允许前端 5173 跨域访问
CORS_ORIGIN="http://localhost:5173"

# 日志格式：dev | combined
LOG_FORMAT=dev

# seed 脚本用的初始管理员账号
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123456"
