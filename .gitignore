# ---- 依赖 ----
node_modules/
.pnp
.pnp.js

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo

# ---- 环境变量（务必不要提交真实密钥）----
.env
.env.local
.env.*.local
!.env.example

# ---- 数据库 ----
apps/api/prisma/*.db
apps/api/prisma/migrations/dev.db*

# ---- 上传文件 ----
uploads/

# ---- 编辑器 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 说明：docker-compose.override.yml 会提交到 Git（保留）
# 它只把 MySQL 端口绑到 127.0.0.1，供本地开发连接，不构成安全风险，
# 而且新成员克隆后直接 docker compose up -d db 就能用，省一步手工操作。
# 生产环境部署时显式指定 -f 参数，override 文件不会被加载。
